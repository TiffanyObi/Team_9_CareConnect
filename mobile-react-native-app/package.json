    "@react-navigation/native-stack": "^7.3.0",
    "expo": "57.0.14",
    "expo-crypto": "^57.0.3",
    "expo-sqlite": "^57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
