{
  "name": "careconnect-electron-app",
  "private": true,
  "version": "1.0.0",
  "description": "CareConnect Electron starter application for Team 9",
  "main": "main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "start": "npm run build && electron .",
    "build": "esbuild renderer.jsx --bundle --minify --outfile=dist/renderer.js",
    "test": "npm run build && node tests/smoke.cjs",
    "test:auth": "npm run build && node tests/auth.cjs",
    "test:clipboard": "npm run build && node tests/clipboard.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "43.4.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
